# The Hub on the host for development (scripts/dev.sh). Copied to .env.dev on the first `scripts/dev.sh up`.
# Relative paths are from the repository root. Anything of hub/app/config.py (Settings) can be set here.

MUSIC_ROOT=data/music
DATA_DIR=data/hub
CONFIG_FILE=config.dev.yaml
DATABASE_URL=postgresql://homemusic:homemusic@localhost:54320/homemusic
# disposable databases of the tests are made on the same server
TEST_DATABASE_URL=postgresql://homemusic:homemusic@localhost:54320/postgres
NAVIDROME_URL=http://localhost:4533
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=admin
YTDLP_POT_BASE_URL=http://localhost:4416
YTDLP_CACHE_DIR=data/hub/yt-dlp-cache
PUBLIC_HUB_URL=http://localhost:5173
# no embedder locally: mixes and the wave are built without the sound
EMBEDDER_URL=
LOG_LEVEL=INFO
# true: no workers, no scheduled jobs (downloads, mixes, mirroring of playlists stay still)
DISABLE_BACKGROUND=false

# Filled by `scripts/dev.sh up` on the first start
HUB_SECRET_KEY=

# The assistant's screenshots need it
LLM_API_KEY=
