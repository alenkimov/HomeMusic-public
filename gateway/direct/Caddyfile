# The Hub straight from this computer, for a home with a public (static) IP address: no VPS, no tunnel.
# The router forwards ports 80 and 443 here; the domain's A record points at the home's address; Caddy gets the
# certificate from Let's Encrypt by itself and renews it. Navidrome is not published: the Hub is all the web app and the other players need.
{$PUBLIC_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	# Other players (Subsonic: /rest) come to the Hub too — it checks their sign-in and counts the wrong passwords
	# before anything reaches Navidrome (hub/app/api/subsonic.py, hub/app/guard.py).
	# SSE (/api/events) is flushed immediately; uploads up to 500 MB are streamed without a body limit.
	reverse_proxy hub:8080 {
		flush_interval -1
		# Audio is sent from here, not by Python: told it may (X-HomeMusic-Accel), the Hub checks who asks, picks the
		# file and answers with its place only (X-Accel-Redirect, hub/app/api/listen.py `accel_path`). Caddy reads it
		# from the folders mounted under /srv/_files (docker-compose.yml) with the ranges a seek asks for.
		header_up X-HomeMusic-Accel 1
		@accel header X-Accel-Redirect *
		handle_response @accel {
			root * /srv
			rewrite * {rp.header.X-Accel-Redirect}
			# what the Hub said of the file goes with it (the audio's type, where it is from, the Hub's mark)
			copy_response_headers {
				include Content-Type Cache-Control X-HomeMusic-Hub X-HomeMusic-Listen-Kind X-HomeMusic-Source X-HomeMusic-Variant
			}
			file_server
		}
	}
}
