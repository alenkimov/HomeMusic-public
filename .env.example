# Copy to .env and fill in. Never commit .env.
# Only what a setup has to decide is here. Every other setting of the Hub (hub/app/config.py, Settings) has a default
# and can still be set here by its name in upper case, e.g. LOG_LEVEL=DEBUG or LLM_MODEL=...

# --- Required ------------------------------------------------------------------
# Music folder with library/, .trash/, .backups/ (on Windows e.g. B:\Music); the Hub's working files are in the
# hub-data volume (STAGING_ROOT in docker-compose.yml)
MUSIC_ROOT=
# Random string; Navidrome encrypts stored user passwords with it. Don't change after the first start.
ND_PASSWORDENCRYPTIONKEY=
# Navidrome admin: the Hub uses it for library scans and to create users
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PASSWORD=
# PostgreSQL password of the Hub (long random value)
HUB_DB_PASSWORD=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_SECRET_KEY=

# --- Access from outside (README, «Доступ снаружи») ------------------------------
# Public addresses of the Hub and Navidrome: links, QR codes, what the app is told. Empty — home network only.
PUBLIC_HUB_URL=
PUBLIC_MUSIC_URL=
# direct — Caddy on this computer serves https://PUBLIC_DOMAIN (PUBLIC_MUSIC_URL stays empty);
# tunnel — reverse SSH tunnel to the VPS at VPS_HOST
# COMPOSE_PROFILES=direct
# PUBLIC_DOMAIN=music.example.com
# COMPOSE_PROFILES=tunnel
# VPS_HOST=203.0.113.10

# --- AI: lyrics translation, mixes, «Наведение порядка» (any OpenAI-compatible API) --
# OpenRouter key: https://openrouter.ai/keys. Empty — no AI translation of lyrics, and «Наведение порядка»
# goes by its rules alone.
LLM_API_KEY=
# Defaults: OpenRouter and anthropic/claude-haiku-5.5. Local Ollama instead:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3-vl:8b
# What «Наведение порядка» may spend on the AI in a month, USD (default 2; 0 — rules only)
# TIDY_AI_USD_MONTH=2

# --- Backups to Google Drive (README, «Резервные копии») -------------------------------
# An OAuth client of type «TVs and Limited Input devices». Empty — backups stay on the server's disk only.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=

# --- Optional ---------------------------------------------------------------------
# Users' local time: the hour mixes are built (default Europe/Moscow)
# TIMEZONE=Europe/Moscow
# Shared Telegram bot for sending tracks (token from @BotFather). Empty — no Telegram.
TELEGRAM_BOT_TOKEN=
# Registration by email without an invite: SMTP of any mailbox (Gmail: smtp.gmail.com and an app password).
# Empty host — no such registration. SMTP_PORT defaults to 587, SMTP_FROM to SMTP_USER.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Netscape cookies of youtube.com when YouTube asks «not a robot» (README). Path inside the container.
# YTDLP_COOKIES_FILE=/music/.youtube-cookies.txt
# Proxies of services and accounts are set in the app: «Меню» → «Прокси и запросы» (admins)
